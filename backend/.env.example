# Google AI (Gemini)
GOOGLE_API_KEY=your-google-ai-studio-key-here

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Supabase — use SERVICE ROLE key (server-side only, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WOUND_IMAGES_BUCKET=wound-images
